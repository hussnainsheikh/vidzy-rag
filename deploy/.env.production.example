APP_ENV=production
CHROMA_PATH=/var/lib/vidzy-rag/chroma
KNOWLEDGE_PATH=/opt/vidzy-rag/knowledge
STATIC_DIR=/opt/vidzy-rag/web/dist
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
RAG_RESPONSE_MODE=retrieval
DIRECT_ANSWER_THRESHOLD=0.68
RELATED_RESULTS_THRESHOLD=0.35
AMBIGUITY_MARGIN=0.035
RETRIEVAL_K=5
MAX_QUESTION_LENGTH=500
CORS_ORIGINS=https://rag.vidzyplayer.com

# Generate on the server with: openssl rand -hex 32
INTERNAL_API_KEY=

# Generation remains disabled. Do not set an external provider key initially.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
LLM_FALLBACK_TO_RETRIEVAL=true
