APP_ENV=development
CHROMA_PATH=.data/chroma
KNOWLEDGE_PATH=knowledge
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
RAG_RESPONSE_MODE=retrieval
DIRECT_ANSWER_THRESHOLD=0.68
RELATED_RESULTS_THRESHOLD=0.35
AMBIGUITY_MARGIN=0.035
RETRIEVAL_K=5
MAX_QUESTION_LENGTH=500
CORS_ORIGINS=http://localhost:5173

# Required only for internal or combined /api/search requests.
INTERNAL_API_KEY=

# Optional future generation. A key alone never enables generation.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
LLM_FALLBACK_TO_RETRIEVAL=true
